# FASTAPI_DDD_TEMPLATE application settings
FASTAPI_DDD_TEMPLATE_ENV=prod
FASTAPI_DDD_TEMPLATE_DEBUG=false
FASTAPI_DDD_TEMPLATE_LOG_DIR=/fastapi_ddd_template/logs

FASTAPI_DDD_TEMPLATE_JWT_ALGORITHM=HS256
FASTAPI_DDD_TEMPLATE_JWT_TOKEN_EXPIRY_TIME=30

# FASTAPI_DDD_TEMPLATE server settings for entrypoint
SERVER_HOST=127.0.0.1
SERVER_PORT=8000

# DB settings
DB_ADMIN=postgres
DB_PATH=fastapi_ddd_template_prod_db
DB_HOST=db
DB_PORT=5432
DB_DRIVER=postgresql+asyncpg
DB_USER=prod_db_user
DB_TABLE_SCHEMA=fastapi_ddd_template 

# FASTAPI_DDD_TEMPLATE bootstrap settings
FASTAPI_DDD_TEMPLATE_BOOTSTRAP_FLAG=true
FASTAPI_DDD_TEMPLATE_BOOTSTRAP_ADMIN=admin
